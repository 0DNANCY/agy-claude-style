{
  "command": "node",
  "args": ["--max-old-space-size=192", "main.mjs"],
  "env": {
    "NODE_USE_ENV_PROXY": "1"
  },
  "restart_policy": "always",
  "display_name": "Claude Style",
  "description": "AGY Claude Style 控制室：实时调整外观配色、Rewind 回退面板、双圆环与 Token HUD、5 语言切换及 CDP 注入状态。",
  "has_web_ui": true,
  "ui_config": {
    "display_name": "Claude Style",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Claude Style"
      }
    ]
  }
}
